	<subDataset name="VEHINOUTDS" uuid="0c210006-89c1-4446-9ee2-378a6f34c92c">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="EBSProd"/>
		<parameter name="fromDate" class="java.util.Date"/>
		<parameter name="toDate" class="java.util.Date"/>
		<parameter name="ouId" class="java.lang.Integer"/>
		<parameter name="locId" class="java.lang.Integer"/>
		<queryString language="SQL">
			<![CDATA[select rownum , a.*   from ( select  NVL(REG_NO,'-') REG_NO, NVL(chassis_no,'-') chassis_no,
             NVL(VEH_WASH_NO,'-') VEH_WASH_NO, NVL(case when model='null' then '-' else model end,'-') MODEL,
            NVL(case when service_advisor='null' then '-' else service_advisor end,'-') service_advisor,
             NVL(washing_supervisor,'-') washing_supervisor, NVL(TO_CHAR(FS_IN_TIME,'DD-MM-YYYY HH24:MI:SS'),'-') FS_IN_TIME,
             NVL(AIR_BLOW_STN,'-') AIR_BLOW_STN, NVL(UNDERBODY_STN,'-') UNDERBODY_STN, NVL(ENGINE_ROOM_STN,'-') ENGINE_ROOM_STN,
            NVL(TO_CHAR(FS_OUT_TIME,'DD-MM-YYYY HH24:MI:SS'),'-') FS_OUT_TIME,
            NVL(TO_CHAR(SS_IN_TIME,'DD-MM-YYYY HH24:MI:SS'),'-') SS_IN_TIME , NVL(LOOSE_ITEMS_STN,'-') LOOSE_ITEMS_STN, 
            NVL(VEH_INTERIOR_STN,'-') VEH_INTERIOR_STN, NVL(TO_CHAR(SS_OUT_TIME,'DD-MM-YYYY HH24:MI:SS'),'-') SS_OUT_TIME , 
            NVL(TO_CHAR(DS_IN_TIME,'DD-MM-YYYY HH24:MI:SS'),'-') DS_IN_TIME , 
            NVL(VEH_EXTERIOR_STN,'-') VEH_EXTERIOR_STN, NVL(GLASS_POLISH_STN,'-') GLASS_POLISH_STN, 
            NVL(TO_CHAR(DS_OUT_TIME,'DD-MM-YYYY HH24:MI:SS'),'-') DS_OUT_TIME,
            NVL(LOCATION,'-') LOCATION,
            NVL(TO_CHAR(CREATION_DATE,'DD-MM-YYYY HH24:MI:SS'),'-') CREATION_DATE
            FROM SS_VEH_WASHING_REGISTER 
            WHERE OU_ID= $P{ouId}
            and LOC_ID= $P{locId}
            and CREATION_DATE BETWEEN $P{fromDate}  AND  $P{toDate}
            ORDER BY washing_supervisor, CREATION_DATE DESC ) a]]>
		</queryString>
