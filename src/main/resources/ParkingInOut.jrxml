		<parameter name="ouId" class="java.lang.Integer"/>
		<parameter name="locId" class="java.lang.Integer"/>
		<queryString language="SQL">
			<![CDATA[SELECT ROW_NUMBER() OVER (ORDER BY creation_date) AS sr_no, NVL(REG_NO,'-') REG_NO, NVL(CHASSIS_NO,'-') CHASSIS_NO, 
NVL(ENGINE_NO,'-') ENGINE_NO, NVL(VIN,'-') VIN, NVL(DEPT,'-') DEPT, NVL(DRIVER_IN,'-') DRIVER_IN,
NVL(DRIVER_OUT,'-') DRIVER_OUT, NVL(OUT_KM,0) OUT_KM, NVL(TO_CHAR(OUT_TIME,'YYYY-MM-DD HH24:MI:SS'),'-') OUT_TIME, NVL(IN_KM,0) IN_KM,
 NVL(TO_CHAR(IN_TIME,'YYYY-MM-DD HH24:MI:SS'),'-') IN_TIME, NVL(LOCATION,'-') LOCATION, NVL(LOC_ID,0) LOC_ID, NVL(OU_ID,0) OU_ID,
 NVL(GATE_NO,'-') GATE_NO, NVL(GATE_TYPE,'-') GATE_TYPE, NVL(REMARKS,'-') REMARKS, NVL(CUST_NAME,'-') CUST_NAME,
NVL(PARKING_REASON, '-') PARKING_REASON, NVL(PARKING_DESC,'-') PARKING_DESC, NVL(ATTRIBUTE1,'-') SERVICE_ADVISOR, NVL(ATTRIBUTE2,'-') MODEL_DESC,
 NVL(CREATED_BY,'-') CREATED_BY,  NVL(TO_CHAR(CREATION_DATE,'YYYY-MM-DD HH24:MI:SS'),'-') CREATION_DATE, NVL(UPDATED_BY,'-') UPDATED_BY,
 NVL(TO_CHAR(UPDATION_DATE,'YYYY-MM-DD HH24:MI:SS'),'-') UPDATION_DATE
FROM SS_DMS_WS_PARKING WHERE OU_ID=$P{ouId} and LOC_ID=$P{locId}  AND 
CREATION_DATE BETWEEN $P{fromDate}  AND  $P{toDate}]]>
		</queryString>
